{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "type": "string" }
      },
      "required": ["repository"]
    },
    "service": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "port": { "type": "integer", "minimum": 1 }
      }
    },
    "containerPort": { "type": "integer", "minimum": 1 },
    "resources": { "type": "object" },
    "env": {
      "type": "object",
      "properties": {
        "DB_HOST": { "type": "string" },
        "DB_SECRET_ARN": { "type": "string" },
        "DB_NAME": { "type": "string" },
        "DB_USER": { "type": "string" },
        "DB_PORT": { "type": "string" }
      }
    }
  },
  "required": ["image", "env"]
}
